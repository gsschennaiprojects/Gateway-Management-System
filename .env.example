# ============================================================================
# GATEWAY SOFTWARE SOLUTIONS (GSS) — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local execution, or add to Vercel Environment Variables
# ============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Gateway Software Solutions Management System"
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Firebase Client SDK Configuration (Client-side safe)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Firebase Admin Service Account (JSON string or base64 encoded for production deployment)
FIREBASE_SERVICE_ACCOUNT_KEY="your-service-account-json-or-base64"

# Google Cloud Service Account & Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PROJECT_ID="your-google-project-id"

# Operational Branch Google Spreadsheet IDs (1 per branch)
SPREADSHEET_ID_CHN="your-chennai-spreadsheet-id"
SPREADSHEET_ID_CBE="your-coimbatore-spreadsheet-id"
SPREADSHEET_ID_MDU="your-madurai-spreadsheet-id"
SPREADSHEET_ID_ERD="your-erode-spreadsheet-id"

# Required to sign server-side session cookies (generate and store as a secret; minimum 32 bytes)
SESSION_SECRET="replace-with-a-random-32-byte-or-longer-secret"
