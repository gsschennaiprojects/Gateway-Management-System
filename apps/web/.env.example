# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Gateway Software Solutions Management System"
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"
APP_URL="https://your-production-domain.example"

# Firebase Client SDK Configuration (Client-side safe)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Google Cloud Service Account & Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PROJECT_ID=""

# Operational Branch Google Spreadsheet IDs (1 per branch)
SPREADSHEET_ID_CHN=""
SPREADSHEET_ID_CBE=""
SPREADSHEET_ID_MDU=""
SPREADSHEET_ID_ERD=""

# Firebase Auth verifies credentials and Firebase Admin signs HttpOnly session cookies.
