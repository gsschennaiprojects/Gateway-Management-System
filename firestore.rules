rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and mutations flow through authenticated Next.js server routes
    // using the Firebase Admin SDK. Client SDK access is denied so profiles,
    // operational records, and legacy credential fields cannot be enumerated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
