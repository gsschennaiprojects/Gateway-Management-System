# ==============================================================================
# GATEWAY SOFTWARE SOLUTIONS (GSS) MANAGEMENT SYSTEM
# Enterprise Production .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production build & compilation outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Test outputs, reports, and coverage
coverage/
test-results/
playwright-report/
blob-report/
*.lcov

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env*.local
.env
.env.production
.env.staging
!.env.example
!apps/web/.env.example
*.pem
*.key
*.cert

# Service account keys & cloud credentials (keep strictly local)
management-system-*.json
client_secret_*.json
*-adminsdk-*.json
firebase-admin-key.json
service-account*.json

# Generated exports and test artifacts
*.xlsx
Test_Export.xlsx

# Cache and temporary directories
.cache/
.turbo/
*.tmp
*.bak
*.old
*.orig
*.backup

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS & Editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# AI / IDE / Agent scratch metadata
.gstack/
.superpowers/
.gemini/
.claude/
